{
  "name": "@dsgraph/sources",
  "version": "0.6.0",
  "description": "Virtual file systems for dsgraph: in-memory, npm (jsDelivr) and Node file system.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specsure/specsure.git",
    "directory": "packages/dsgraph-sources"
  },
  "dependencies": {
    "@dsgraph/core": "0.6.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "homepage": "https://github.com/specsure/specsure/tree/main/packages/dsgraph-sources#readme",
  "bugs": {
    "url": "https://github.com/specsure/specsure/issues"
  }
}

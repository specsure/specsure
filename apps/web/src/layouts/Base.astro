---
import Analytics from '@vercel/analytics/astro'
import core from '../../../../packages/dsgraph-core/package.json'
import Backdrop from '../components/Backdrop.astro'
import { type Lang, localePath } from '../i18n'
import { messages } from '../i18n/messages'
import { GUIDE } from '../lib/guide'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** The page's address without the language prefix, e.g. `/tools/diff`. */
  path: string
  lang?: Lang
}
const { title, description, path, lang = 'en' } = Astro.props
const m = messages[lang]
const other: Lang = lang === 'en' ? 'ru' : 'en'
const href = (p: string) => localePath(lang, p)
// The source is linked from About and the footer.
const nav = [
  { href: href('/tools/diff'), label: m.site.nav.diff, current: ['/tools/diff'] },
  { href: href('/tools/fix'), label: m.site.nav.fix, current: ['/tools/fix'] },
  {
    href: href('/guide'),
    label: m.site.nav.guide,
    current: GUIDE.map((p) => p.path),
    wide: true,
  },
  { href: href('/tools/mcp'), label: m.site.nav.mcp, current: ['/tools/mcp'] },
  {
    href: 'https://github.com/specsure/specsure/tree/main/packages/dsgraph-cli#readme',
    label: m.site.nav.cli,
  },
]
const year = new Date().getFullYear()

/**
 * First visit to an English page: a reader whose browser or system prefers Russian gets the
 * Russian one. A choice made with the language switch is remembered and always wins; Russian
 * pages never send anyone away.
 */
/**
 * Page views only, through Vercel Web Analytics (no cookies). The address goes without its query
 * and fragment: a comparison link can name a private repository or carry files after `#`.
 */
const PAGE_ONLY = `window.webAnalyticsBeforeSend = (event) => ({ ...event, url: event.url.split(/[?#]/)[0] })`

const DETECT = `(() => {
  try { if (localStorage.getItem('specsure.lang')) return } catch (e) {}
  const prefs = [].concat(navigator.languages || [], navigator.language || [])
  try { prefs.push(Intl.DateTimeFormat().resolvedOptions().locale) } catch (e) {}
  for (const p of prefs) {
    const base = String(p || '').toLowerCase().slice(0, 2)
    if (base === 'en') return
    if (base === 'ru') {
      location.replace('/ru' + location.pathname + location.search + location.hash)
      return
    }
  }
})()`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {lang === 'en' && <script is:inline set:html={DETECT} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:url" content={new URL(href(path), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localePath('en', path), Astro.site)} />
    <link rel="alternate" hreflang="ru" href={new URL(localePath('ru', path), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), Astro.site)} />
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f2f5" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={PAGE_ONLY} />
    <Analytics />
  </head>
  <body>
    <Backdrop variant={path === '/' ? 'full' : 'subtle'} />
    <header class="site-header">
      <a class="wordmark" href={href('/')}>
        <svg class="mark" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
          <rect x="2" y="5" width="20" height="10.5" rx="5.25" fill="currentColor"></rect>
          <rect class="mark__after" x="10" y="16.5" width="20" height="10.5" rx="5.25"></rect>
        </svg>
        <span class="wordmark__text">Specsure</span>
      </a>
      <nav class="site-nav">
        {nav.map((n) => (
          <a
            href={n.href}
            class={'wide' in n ? 'site-nav__wide' : undefined}
            aria-current={n.current?.includes(path) ? 'page' : undefined}
          >
            {n.label.startsWith('Token ') ? (
              <>
                <span class="site-nav__prefix">Token </span>
                {n.label.slice(6)}
              </>
            ) : (
              n.label
            )}
          </a>
        ))}
        <button type="button" class="nav-button" data-about-open>{m.site.nav.about}</button>
        <span class="lang-switch" role="group" aria-label="Language · Язык">
          {(['en', 'ru'] as const).map((l) =>
            l === lang ? (
              <span class="lang-switch__item is-on" aria-current="true" lang={l}>{l.toUpperCase()}</span>
            ) : (
              <a
                class="lang-switch__item"
                href={localePath(l, path)}
                hreflang={l}
                lang={l}
                title={m.switchLabel}
                data-lang-switch={l}
              >{l.toUpperCase()}</a>
            ),
          )}
        </span>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <dialog class="about" id="about" aria-label={m.site.about.label} tabindex="-1">
      <header class="about__head">
        <svg class="mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
          <rect x="2" y="5" width="20" height="10.5" rx="5.25" fill="currentColor"></rect>
          <rect class="mark__after" x="10" y="16.5" width="20" height="10.5" rx="5.25"></rect>
        </svg>
        <h2>Specsure</h2>
        <form method="dialog">
          <button class="ghost" aria-label={m.site.about.close}>✕</button>
        </form>
      </header>
      <div class="about__body">
        <p class="about__lead">{m.site.about.lead}</p>
        <ul class="about__list">
          {m.site.about.points.map((p) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              {p}
            </li>
          ))}
        </ul>
        <p class="about__links">
          <a href={href('/guide')}>{m.site.about.guide}</a>
          <a href="https://github.com/specsure/specsure">{m.site.about.github}</a>
        </p>
        <div class="about__foot">
          <span>{m.site.about.madeBy} <a href="https://adamreznik.com" target="_blank" rel="noopener noreferrer">Adam Reznik</a></span>
          <span class="muted">© {year} Adam Reznik · dsgraph {core.version}</span>
          <span class="muted">{m.site.about.owners}</span>
        </div>
      </div>
    </dialog>
    <script>
      const about = document.getElementById('about') as HTMLDialogElement | null
      for (const b of document.querySelectorAll('[data-about-open]'))
        b.addEventListener('click', () => {
          about?.showModal()
          // The window itself takes the focus, not its first button: a ring on ✕ looks like a selection.
          about?.focus()
        })
      about?.addEventListener('click', (e) => {
        if (e.target === about) about.close()
      })
      // The switch remembers the choice and keeps the page state (Token Diff keeps it in the address).
      for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]'))
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('specsure.lang', a.dataset.langSwitch ?? 'en')
          } catch {}
          a.href = `${a.pathname}${location.search}${location.hash}`
        })
    </script>
    <footer class="site-footer">
      <span>{m.site.footer}</span>
      <a href="https://github.com/specsure/specsure">{m.site.source}</a>
    </footer>
  </body>
</html>

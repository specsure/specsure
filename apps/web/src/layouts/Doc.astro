---
import Base from './Base.astro'

interface Props {
  frontmatter: { title: string; description: string; path: string }
}
const { frontmatter } = Astro.props
---

<Base title={`${frontmatter.title} · Specsure`} description={frontmatter.description} path={frontmatter.path}>
  <article class="prose">
    <slot />
  </article>
</Base>

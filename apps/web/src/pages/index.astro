---
import LiveFigure from '../components/LiveFigure'
import Base from '../layouts/Base.astro'

const tools = [
  {
    href: '/tools/diff',
    icon: 'diff',
    title: 'Token Diff',
    text: 'Two versions of design tokens: what changed in each theme, what breaks, which version to ship',
    tag: 'Web',
  },
  {
    href: 'https://github.com/specsure/specsure/tree/main/packages/dsgraph-cli#readme',
    icon: 'terminal',
    title: 'dsgraph CLI',
    text: 'The same diff and checks in your terminal and CI: npx dsgraph diff',
    tag: 'npm',
  },
  {
    href: 'https://github.com/specsure/specsure/tree/main/packages/dsgraph-action#readme',
    icon: 'action',
    title: 'GitHub Action',
    text: 'A report on every pull request that touches tokens, and a failed check when it breaks',
    tag: 'Action',
  },
  {
    href: 'https://github.com/specsure/specsure',
    icon: 'graph',
    title: 'dsgraph',
    text: 'The open engine behind it: DTCG 2025.10, snapshots, diff, rules',
    tag: 'MIT',
  },
  {
    href: null,
    icon: 'figma',
    title: 'Figma plugin',
    text: 'Check Figma variables and styles against your tokens, inside Figma',
    tag: 'Soon',
  },
]

/**
 * What dsgraph does with tokens, whatever wrote them. Titles are our capabilities; the formats
 * they come from are only labels. Examples are neutral.
 */
const formats = [
  {
    name: 'Themes and modes found on their own',
    what: 'Every theme is compared separately: dark can break while light stays the same',
    code: `"$extensions": { "mode": {
  "light": "{color.white}",
  "dark": "{color.black}"
} }`,
    from: 'Resolver sets · theme files · $extensions.mode',
  },
  {
    name: 'Math and color modifiers calculated',
    what: 'Change the base value and every token built on it shows up',
    code: `"lg": {
  "value": "{space.base} * 2",
  "type": "spacing"
}`,
    from: 'Token JSON with expressions',
  },
  {
    name: 'References followed to the end',
    what: 'A change deep in an alias chain is reported with its cause',
    code: `"primary": {
  "value": "{color.base.ink.value}"
}`,
    from: 'Token JSON with value and type',
  },
  {
    name: 'Colors compared by how they look',
    what: 'ΔE in OKLab, any color space; changes no one can see are a patch',
    code: `"$value": {
  "colorSpace": "oklch",
  "components": [0.62, 0.19, 259]
}`,
    from: 'DTCG 2025.10',
  },
  {
    name: 'CSS read as tokens',
    what: 'Custom properties become tokens; selectors become themes',
    code: `:root { --bg: #ffffff; }
[data-theme="dark"] { --bg: #0c0c0e; }
.dark { --bg: #0c0c0e; }`,
    from: 'CSS custom properties',
  },
  {
    name: 'Any version, nothing uploaded',
    what: 'Published packages and branches are fetched by your browser',
    code: `npm:@scope/tokens@2.1.0
github:owner/repo/tokens@main
./tokens  (dropped files)`,
    from: 'npm · GitHub · files',
  },
]

const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
/** Quiet highlighting: keys are dimmed, references stand out. */
const highlight = (code: string) =>
  escapeHtml(code)
    .replace(/("[\w$.-]+")(\s*:)/g, '<span class="tok-key">$1</span>$2')
    .replace(/(\{[\w.-]+\})/g, '<span class="tok-ref">$1</span>')
    .replace(/(--[\w-]+)(?=:)/g, '<span class="tok-key">$1</span>')
---

<Base
  title="Specsure · tools for design systems"
  description="Open-source tools for design systems: Token Diff shows what a token release changes and breaks. No account, no server."
  path="/"
>
  <header class="home-head">
    <h1>Know what your design system release breaks</h1>
    <p>
      Open-source tools for design systems. No account and no server: they run in your browser, your CI
      or your terminal.
    </p>
  </header>

  <nav class="window launcher" aria-label="Tools">
    <div class="launcher__head">
      <span>Tools</span>
      <span class="count">{tools.length}</span>
    </div>
    {
      tools.map((t, i) => {
        const Tag = t.href ? 'a' : 'div'
        return (
          <Tag class={`launcher__row${t.href ? '' : ' is-soon'}${i === 0 ? ' is-default' : ''}`} href={t.href ?? undefined}>
            <span class="launcher__icon" aria-hidden="true">
              {t.icon === 'diff' && (
                <svg width="20" height="20" viewBox="0 0 32 32">
                  <rect x="2" y="5" width="20" height="10.5" rx="5.25" fill="currentColor" />
                  <rect x="10" y="16.5" width="20" height="10.5" rx="5.25" fill="var(--accent-fill)" />
                </svg>
              )}
              {t.icon === 'figma' && (
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.5 7.5h11M4.5 12.5h11M7.5 4.5v11M12.5 4.5v11" />
                </svg>
              )}
              {t.icon === 'action' && (
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="6" cy="5" r="2" />
                  <circle cx="6" cy="15" r="2" />
                  <circle cx="14" cy="10" r="2" />
                  <path d="M6 7v6M8 5.5c3 0 4 1.5 4.5 2.7" />
                </svg>
              )}
              {t.icon === 'terminal' && (
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m5 6.5 3.5 3.5L5 13.5M10.5 14h4.5" />
                </svg>
              )}
              {t.icon === 'graph' && (
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <circle cx="5" cy="5.5" r="2" />
                  <circle cx="15" cy="5.5" r="2" />
                  <circle cx="10" cy="15" r="2" />
                  <path d="M6.6 6.9 9 13.2M13.4 6.9 11 13.2M7 5.5h6" />
                </svg>
              )}
            </span>
            <span class="launcher__text">
              <span class="launcher__title">{t.title}</span>
              <span class="launcher__sub">{t.text}</span>
            </span>
            <span class={`tag${t.tag === 'Soon' ? ' tag--soon' : ''}`}>{t.tag}</span>
            {t.href && <span class="launcher__go" aria-hidden="true">↵</span>}
          </Tag>
        )
      })
    }
    <footer class="actionbar">
      <span class="actionbar__status">Free · No sign-up · Nothing is uploaded</span>
      <a class="launcher__primary" href="/tools/diff">Open Token Diff <kbd>↵</kbd></a>
    </footer>
  </nav>
  <section class="home-section" aria-labelledby="formats">
    <header class="home-section__head">
      <h2 id="formats">Reads your tokens as they are</h2>
      <p>
        Whatever wrote them, tokens become one graph, so the comparison and the checks work the same
        for every source. No conversion step and no config for the usual layouts.
      </p>
    </header>
    <ul class="formats">
      {
        formats.map((f) => (
          <li class="format">
            <div class="format__name">{f.name}</div>
            <div class="format__what">{f.what}</div>
            <pre class="format__code"><code set:html={highlight(f.code)} /></pre>
            <div class="format__from">{f.from}</div>
          </li>
        ))
      }
    </ul>
    <p class="formats__note">
      Reads DTCG 2025.10, older token JSON with <code>value</code> and <code>type</code>, Figma
      variables exported to JSON and CSS custom properties.
    </p>
  </section>

  <section class="home-section" aria-labelledby="live">
    <header class="home-section__head">
      <h2 id="live">A release, compared right here</h2>
      <p>
        Not a screenshot: two versions of a small token file, compared by dsgraph in your browser as
        this page loaded.
      </p>
      <a class="home-section__link" href="/tools/diff?example">Open it in Token Diff →</a>
    </header>
    <LiveFigure client:only="react" name="result" />
  </section>

  <script>
    // ↵ opens Token Diff, as the hint in the action bar says; focused links keep their own Enter.
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target === document.body || e.target === document.documentElement))
        location.href = '/tools/diff'
    })
  </script>
</Base>

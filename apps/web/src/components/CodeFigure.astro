---
/**
 * The home page's code figure: a small app on the example's tokens, checked by the real engine when
 * the site is built and drawn by the same component as Token Diff's Your code window. Plain HTML,
 * no script on the page.
 */
import { cssTokens } from '@dsgraph/adapters'
import { DsGraph, diff, scan } from '@dsgraph/core'
import { MemorySource } from '@dsgraph/sources'
import type { Lang } from '../i18n'
import { checkCode } from '../lib/code'
import { EXAMPLE, EXAMPLE_APP } from '../lib/example'
import type { DroppedFile } from '../lib/types'
import CodeReportFigure from './CodeReportFigure'

interface Props {
  lang: Lang
  caption: string
}
const { lang, caption } = Astro.props

const source = (fs: DroppedFile[]) => new MemorySource(Object.fromEntries(fs.map((f) => [f.path, f.text])))
const graphOf = async (fs: DroppedFile[]) =>
  DsGraph.from(await scan(source(fs), {}, { adapters: [cssTokens] }))
const [base, head] = await Promise.all([graphOf(EXAMPLE.base), graphOf(EXAMPLE.head)])
const report = await checkCode({ kind: 'files', files: EXAMPLE_APP }, base, head, await diff(base, head))
---

<CodeReportFigure report={report} lang={lang} caption={caption} />

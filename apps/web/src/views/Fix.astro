---
import TokenFix from '../components/TokenFix'
import { type Lang, localePath } from '../i18n'
import { messages } from '../i18n/messages'
import Base from '../layouts/Base.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const p = messages[lang].fixPage
---

<Base title={p.title} description={p.description} path="/tools/fix" lang={lang}>
  <header class="page-head">
    <h1>Token Fix</h1>
    <p>
      {p.lead}{' '}
      <a class="inline-link" href={localePath(lang, '/tools/fix/guide')}>{p.guide}</a>
      {' · '}
      <a class="inline-link" href={localePath(lang, '/tools/mcp')}>{p.how}</a>
    </p>
  </header>
  <TokenFix client:only="react" lang={lang} />
</Base>
